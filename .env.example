# Copy this file to .env, then change every password/key below
#   cp .env.example .env

# --- Postgres (admin user; n8n also uses it for the "n8n" database) ---
POSTGRES_USER=n8n_admin
POSTGRES_PASSWORD=change-me-admin
POSTGRES_DB=n8n

# --- "livestream" database ---
# livestream_app    : read/write, used by the ingest workflows and the extractor
# livestream_reader : read-only, used by the Q&A AI agent
LIVESTREAM_APP_PASSWORD=change-me-writer
LIVESTREAM_READER_PASSWORD=change-me-reader
#
# Postgres credentials to create in n8n (Overview → Credentials → Create → Postgres).
# n8n runs in its own container, so the host is the compose service name "postgres",
# NOT localhost (inside the n8n container, localhost is n8n itself):
#
#   "Postgres livestream (write)"  Host: postgres  Port: 5432  Database: livestream
#                                  User: livestream_app     Password: LIVESTREAM_APP_PASSWORD
#                                  SSL: disable
#                                  → workflows 1, 3, 4 (Save to Postgres, Look up livestream, Save scenes & links)
#   "Postgres livestream (read)"   same, but User: livestream_reader  Password: LIVESTREAM_READER_PASSWORD
#                                  → the 8 Postgres tools of workflow 2 (Q&A chat)
#
# Do not use POSTGRES_USER (admin) or the "n8n" / "postgres" databases in these credentials.
# From your own machine (extractor, DBeaver...) the host is 127.0.0.1 instead:
#   PG_DSN=postgresql://livestream_app:PASSWORD@127.0.0.1:5432/livestream   (5433 through the VPS SSH tunnel)

# --- n8n ---
# Generate a random key: openssl rand -hex 32
# Keep this key safe! Losing it means the stored credentials can no longer be decrypted.
N8N_ENCRYPTION_KEY=replace-with-a-long-random-string

# Local machine (http://localhost:5678):
N8N_HOST=localhost
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/
N8N_SECURE_COOKIE=false
N8N_PROXY_HOPS=0

# VPS behind Caddy (docker compose --profile https up -d) — replace the 5 lines above with:
# N8N_HOST=n8n.your-domain.com
# N8N_PROTOCOL=https
# WEBHOOK_URL=https://n8n.your-domain.com/
# N8N_SECURE_COOKIE=true
# N8N_PROXY_HOPS=1
